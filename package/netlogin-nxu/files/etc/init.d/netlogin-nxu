#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/netlogin_openwrt.sh

start_service() {
	config_load netlogin-nxu

	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get username main username
	config_get password main password
	config_get_bool persistent_login main persistent_login 1

	if [ -z "$username" ] || [ -z "$password" ]; then
		logger -t ruijie-nxu -p user.err "未配置账号或密码，服务未启动。"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" --uci
	if [ "$persistent_login" = "1" ]; then
		procd_set_param respawn 3600 5 5
	fi
	procd_close_instance
}

status_service() {
	if pidof netlogin_openwrt.sh >/dev/null 2>&1; then
		echo "netlogin-nxu: running (pid: $(pidof netlogin_openwrt.sh))"
	else
		echo "netlogin-nxu: stopped"
	fi
	echo "最近日志："
	logread -e ruijie-nxu 2>/dev/null | tail -n 10
}
